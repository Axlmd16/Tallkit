https://{{IP}} {
    tls internal
    encode gzip

    handle /api/* {
        request_body {
            max_size 12MB
        }
        reverse_proxy 127.0.0.1:8000
    }

    handle /admin/* {
        reverse_proxy 127.0.0.1:8000
    }

    handle /static/* {
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        root * C:\Tallkit\app\web
        try_files {path} /index.html
        file_server
    }
}
